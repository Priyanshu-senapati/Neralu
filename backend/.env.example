DATABASE_URL=sqlite:///./neralu.db
PUBLIC_BASE_URL=https://<your-ngrok-or-railway-host>
# twilio = real phone calls. browser = calls ring the /phone page (demo fallback, same rules)
TELEPHONY_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
VALIDATE_TWILIO_SIGNATURE=true
STT_PROVIDER=sarvam            # sarvam | bhashini
SARVAM_API_KEY=
BHASHINI_API_KEY=
ANTHROPIC_API_KEY=             # optional, transcript-parsing fallback only
STT_TIMEOUT_S=6
LANGUAGE_MENU=true            # start calls with "1 Kannada, 2 Hindi, 3 English"; no key keeps the registered language
ORIENTATION_MODE=voice         # voice | keypad (Twilio trial accounts cannot record: use keypad)

# Run mode: demo (default; ×DEMO_SPEED clock, presets, reset any time) or pilot (a real day:
# real time, today's Open-Meteo forecast, rounds start by themselves, data kept across restarts,
# a new run each day carrying over the people families registered)
RUN_MODE=demo
PILOT_ROUND_TIMES=11:00,15:00  # IST; a late start runs only the latest round already due
PILOT_CALLS_UNTIL=18:00        # no automatic round starts after this
RECORDING_RETENTION_DAYS=7     # call recordings are deleted this long after the call

# Demo tuning (all escalation timers are in SCENARIO minutes, converted by DemoClock)
DEMO_SPEED=60                  # 1 real second = 60 scenario seconds
MAX_ATTEMPTS=2                 # production value: 3
RING_TIMEOUT_S=15              # real seconds the phone rings (cannot be compressed)
RETRY_GAP_MIN=15
ACK_TIMEOUT_MIN=45             # volunteer / ASHA must accept within this (45 for a live pitch)
VISIT_TIMEOUT_MIN=120          # E8: accepted but no visit recorded after this → ward officer (2 real min at ×60)
AMBER_RECALL_MIN=30
# E7: after a person checks in person, call again this many scenario minutes later (0 turns it off)
AFTERCARE_MIN=60
SCENARIO_START=2026-10-09T10:55:00+05:30

# Demo persona phones (E.164)
KAMALA_PHONE=+91XXXXXXXXXX
VOLUNTEER_DEMO_TOKEN=priya-demo
